# ==============================================================================
# Multi-Tenant Barber Appointment System - Environment Variables Template
# ==============================================================================

# Private PostgreSQL Connection URL (Server-side ONLY - NEVER expose with NEXT_PUBLIC_)
DATABASE_URL="postgresql://user:password@localhost:5432/barber_db"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Better Auth Configuration (Required)
BETTER_AUTH_SECRET="generate-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# SMS Provider Configuration (Netgsm - Server-side ONLY)
NETGSM_USERCODE="your-netgsm-usercode"
NETGSM_PASSWORD="your-netgsm-password"
NETGSM_MSGHEADER="your-approved-header"
# NETGSM_API_URL="https://api.netgsm.com.tr/sms/rest/v2/send"
# NETGSM_TIMEOUT_MS="10000"
