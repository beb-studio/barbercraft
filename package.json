    "platform-admin:grant": "tsx --conditions react-server scripts/platform-admin-cli.ts grant",
    "platform-admin:list": "tsx --conditions react-server scripts/platform-admin-cli.ts list",
    "qa:bootstrap": "tsx --conditions react-server scripts/qa-bootstrap.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker:start": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-fetch/fetch": "^1.3.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.12.0"
}
