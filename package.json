  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:test": "node --test tests/database/*.test.mjs",
    "auth:test": "tsx --conditions react-server --test tests/auth/*.test.ts",
