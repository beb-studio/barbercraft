# ==============================================================================
# BarberCraft Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND FILL IN SECURE PRODUCTION VALUES.
#
# IMPORTANT:
# - NEVER commit .env.production or any file containing real credentials to git.
# - Restrict file permissions: chmod 600 .env.production
# - All server secrets must NEVER be prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (REQUIRED)
# ------------------------------------------------------------------------------

# Environment mode: MUST be production
NODE_ENV=production

# Application domain for Reverse Proxy (e.g. barber.example.com)
APP_DOMAIN=barber.example.com

# Canonical HTTPS base URL of the deployment (MUST match across all three variables)
APP_BASE_URL=https://barber.example.com
BETTER_AUTH_URL=https://barber.example.com
NEXT_PUBLIC_APP_URL=https://barber.example.com

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In Docker Compose, the host is 'db' on the private network.
DATABASE_URL=postgresql://barbercraft:GENERATE_STRONG_DATABASE_PASSWORD@db:5432/barbercraft_prod

# PostgreSQL Container Setup (Used by docker-compose.production.yml)
POSTGRES_DB=barbercraft_prod
POSTGRES_USER=barbercraft
POSTGRES_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------

# Better Auth Secret: Cryptographically random string (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=GENERATE_RANDOM_BASE64_SECRET_MINIMUM_32_CHARACTERS_LONG

# ------------------------------------------------------------------------------
# 3. OUTBOUND SMS: NETGSM PROVIDER (CONDITIONALLY REQUIRED IF SMS ENABLED)
# ------------------------------------------------------------------------------
# When customer notifications are enabled, these credentials are used by the worker
# to dispatch transactional appointment SMS via Netgsm Turkey REST API.

# Netgsm account user code (numeric or string)
NETGSM_USERCODE=
# Netgsm account API password
NETGSM_PASSWORD=
# Approved Netgsm SMS header / sender ID (max 11 alphanumeric characters)
NETGSM_MSGHEADER=
# Optional API endpoint override (Default: https://api.netgsm.com.tr/sms/rest/v2/send)
NETGSM_API_URL=https://api.netgsm.com.tr/sms/rest/v2/send
# Optional HTTP timeout in milliseconds (Default: 10000)
NETGSM_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION POOLING (OPTIONAL / TUNING)
# ------------------------------------------------------------------------------

# Maximum pool connections for the web application (Default: 10)
DB_POOL_MAX=10
# Pool idle connection timeout in milliseconds (Default: 30000)
DB_POOL_IDLE_TIMEOUT_MS=30000
# Pool connection timeout in milliseconds (Default: 5000)
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. BACKGROUND NOTIFICATION WORKER (OPTIONAL / TUNING)
# ------------------------------------------------------------------------------

# Unique identifier for this worker instance (Default: auto-generated uuid)
WORKER_ID=worker-prod-1
# Polling interval in milliseconds when queues are idle (Default: 5000)
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
# Maximum outbox events and deliveries claimed per cycle (Default: 25, max 100)
NOTIFICATION_WORKER_BATCH_SIZE=25

# ------------------------------------------------------------------------------
# 6. OPERATIONAL BACKUP CONFIGURATION (OPTIONAL / TUNING)
# ------------------------------------------------------------------------------

# Target directory for automated backups (Default: /backups)
BACKUP_DIR=/backups
# Backup retention window in days (Default: 7)
RETENTION_DAYS=7
