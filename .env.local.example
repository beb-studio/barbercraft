# ==============================================================================
# BarberCraft Local Development Environment Variables Template
#
# QUICK START:
#   cp .env.local.example .env.local
#   pnpm dev:setup
#   pnpm dev:all
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4380
APP_BASE_URL="http://localhost:4380"
NEXT_PUBLIC_APP_URL="http://localhost:4380"
BETTER_AUTH_URL="http://localhost:4380"

# ------------------------------------------------------------------------------
# 2. LOCAL POSTGRESQL DATABASE (Matches docker-compose.dev.yml)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://barbercraft_user:barbercraft_password@127.0.0.1:55432/barbercraft_dev"
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth)
# ------------------------------------------------------------------------------
# Safe development-only secret (minimum 32 characters)
BETTER_AUTH_SECRET="dev_secret_key_at_least_32_characters_for_local_testing_only_12345"

# ------------------------------------------------------------------------------
# 4. OUTBOUND SMS PROVIDER (SAFE LOCAL MODE)
# ------------------------------------------------------------------------------
# In local development, SMS_PROVIDER is set to "test" to guarantee that NO live SMS
# is ever dispatched, even if Netgsm credentials happen to exist in shell environment.
SMS_PROVIDER="test"

# Netgsm production credentials (DO NOT SET IN LOCAL DEV):
# NETGSM_USERCODE="your-netgsm-usercode"
# NETGSM_PASSWORD="your-netgsm-password"
# NETGSM_MSGHEADER="BARBERCRAFT"
# NETGSM_API_URL="https://api.netgsm.com.tr/sms/rest/v2/send"
# NETGSM_TIMEOUT_MS="10000"

# ------------------------------------------------------------------------------
# 5. BACKGROUND NOTIFICATION WORKER
# ------------------------------------------------------------------------------
WORKER_ID="worker-dev-local"
NOTIFICATION_WORKER_POLL_INTERVAL_MS=3000
NOTIFICATION_WORKER_BATCH_SIZE=10
